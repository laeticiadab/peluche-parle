Options -Indexes
DirectoryIndex index.php
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
RewriteEngine On
RewriteRule (^|/)\.git(/|$) - [F,L,NC]
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
<FilesMatch "^\.">
Require all denied
</FilesMatch>
<FilesMatch "\.(sqlite|db|log|bak)$">
Require all denied
</FilesMatch>
